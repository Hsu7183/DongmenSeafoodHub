{
  "name": "dongmen-seafood-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --config vite.config.mts",
    "build": "vite build --config vite.config.mts",
    "start": "vite preview --config vite.config.mts --host 127.0.0.1 --port 5173",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --env-file=.env scripts/test-integration.mjs",
    "db:start": "node scripts/db/start.mjs",
    "db:stop": "node scripts/db/stop.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "haoding:preview": "node --env-file=.env scripts/haoding/preview.mjs",
    "launch:check": "node --env-file=.env scripts/check-launch.mjs",
    "admin:bootstrap": "node --env-file=.env scripts/bootstrap-admin.mjs",
    "dev:full": "next dev --webpack --hostname 127.0.0.1 --port 3000",
    "build:full": "prisma generate && next build --webpack",
    "start:full": "next start --hostname 127.0.0.1 --port 3000",
    "test:portal": "tsx tests/portal.integration.ts",
    "portal:migrate": "drizzle-kit generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.3",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.1.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/workers-types": "^4.20260515.1",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.3",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
