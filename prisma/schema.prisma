generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  SALES
  CUSTOMER
  SUPPLIER
}
enum OrderStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  ORDERED_TO_SUPPLIER
  PREPARING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}
enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}
enum CommissionStatus {
  PENDING
  CONFIRMED
  PAID
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role
  active       Boolean   @default(true)
  customerId   String?   @unique
  supplierId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  supplier     Supplier? @relation(fields: [supplierId], references: [id])
  sessions     Session[]
  createdAt    DateTime  @default(now())
}
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())
  @@index([key, createdAt])
}
model Customer {
  id              String   @id @default(cuid())
  companyName     String
  stallName       String
  marketName      String   @default("東門市場")
  contactName     String
  phone           String
  lineId          String   @default("")
  email           String   @default("")
  taxId           String   @default("")
  invoiceTitle    String   @default("")
  address         String   @default("")
  deliveryAddress String
  customerType    String   @default("MARKET_STALL")
  priceLevel      String   @default("LEVEL_B")
  salesOwner      String   @default("")
  paymentTerms    String   @default("7天")
  creditLimit     Decimal  @default(0) @db.Decimal(14, 2)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User?
  prices          CustomerPrice[]
  orders          Order[]
  favorites       Favorite[]
  quotations      Quotation[]
}
model Supplier {
  id                  String @id @default(cuid())
  name                String
  contactName         String @default("")
  phone               String @default("")
  email               String @default("")
  address             String @default("")
  website             String @default("")
  authorizationStatus String @default("PENDING")
  active              Boolean @default(true)
  negotiationTargetAmount Decimal @default(0) @db.Decimal(14, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  users               User[]
  products            Product[]
  tiers               VolumeTier[]
  purchaseOrders      PurchaseOrder[]
  commissions         Commission[]
}
model Category {
  id       String @id @default(cuid())
  name     String @unique
  sortOrder Int @default(0)
  active   Boolean @default(true)
  products Product[]
}
model Product {
  id                  String @id @default(cuid())
  supplierId          String
  supplier            Supplier @relation(fields: [supplierId], references: [id])
  supplierProductCode String @default("")
  supplierProductId   String @default("")
  supplierUrl         String @default("")
  sourceType          String @default("DEMO")
  sourceUpdatedAt     DateTime @default(now())
  authorizationStatus String @default("DEMO")
  name                String
  shortName           String @default("")
  brand               String @default("")
  categoryId          String
  category            Category @relation(fields: [categoryId], references: [id])
  description         String @default("")
  origin              String @default("")
  storageMethod       String @default("冷凍")
  temperature         String @default("-18°C 以下")
  imageUrl            String @default("")
  imageSource         String @default("PLACEHOLDER")
  imageAuthorized     Boolean @default(false)
  sourceUrl           String @default("")
  active              Boolean @default(true)
  available           Boolean @default(true)
  supplierStockStatus String @default("AVAILABLE")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  variants            ProductVariant[]
  @@index([supplierId, active])
  @@index([categoryId])
}
model ProductVariant {
  id                 String @id @default(cuid())
  productId          String
  product            Product @relation(fields: [productId], references: [id])
  sku                String @unique
  specification      String
  weight             String @default("")
  packageUnit        String @default("包")
  caseQuantity       Int @default(10)
  moq                Int @default(1)
  supplierCost       Decimal @db.Decimal(14, 2)
  baseWholesalePrice Decimal @db.Decimal(14, 2)
  suggestedPrice     Decimal @db.Decimal(14, 2)
  commissionRate     Decimal? @db.Decimal(7, 4)
  fixedCommission    Decimal? @db.Decimal(14, 2)
  active             Boolean @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  customerPrices     CustomerPrice[]
  levelPrices        PriceLevel[]
  orderItems         OrderItem[]
  favorites          Favorite[]
}
model PriceLevel {
  id        String @id @default(cuid())
  level     String
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  mode      String @default("FIXED")
  value     Decimal @db.Decimal(14, 4)
  @@unique([level, variantId])
}
model CustomerPrice {
  id         String @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  price      Decimal @db.Decimal(14, 2)
  validFrom  DateTime @default(now())
  validTo    DateTime?
  createdAt  DateTime @default(now())
  @@index([customerId, variantId, validFrom])
}
model VolumeTier {
  id               String @id @default(cuid())
  supplierId       String
  supplier         Supplier @relation(fields: [supplierId], references: [id])
  name             String
  minQuantity      Int
  maxQuantity      Int?
  supplierDiscount Decimal @default(0) @db.Decimal(7, 4)
  commissionRate   Decimal @default(0) @db.Decimal(7, 4)
  rebateRate       Decimal @default(0) @db.Decimal(7, 4)
  @@unique([supplierId, minQuantity])
}
model Order {
  id                     String @id @default(cuid())
  orderNumber            String @unique
  customerId             String
  customer               Customer @relation(fields: [customerId], references: [id])
  status                 OrderStatus @default(SUBMITTED)
  paymentStatus          PaymentStatus @default(UNPAID)
  businessModelSnapshot  String @default("COMMISSION")
  totalAmount            Decimal @db.Decimal(14, 2)
  totalCost              Decimal @db.Decimal(14, 2)
  grossProfit            Decimal @db.Decimal(14, 2)
  commissionAmount       Decimal @db.Decimal(14, 2)
  serviceFee             Decimal @default(0) @db.Decimal(14, 2)
  deliveryMethod         String @default("supplier_delivery")
  deliveryDate           DateTime
  deliveryTime           String @default("06:00–10:00")
  deliveryAddress        String
  driver                 String @default("")
  shippingFee            Decimal @default(0) @db.Decimal(14, 2)
  trackingNote           String @default("")
  notes                  String @default("")
  paymentTerms           String
  dueDate                DateTime
  idempotencyKey         String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  items                  OrderItem[]
  payments               Payment[]
  commissions            Commission[]
  @@unique([customerId, idempotencyKey])
  @@index([customerId, createdAt])
  @@index([createdAt, status])
}
model OrderItem {
  id                       String @id @default(cuid())
  orderId                  String
  order                    Order @relation(fields: [orderId], references: [id])
  variantId                String
  variant                  ProductVariant @relation(fields: [variantId], references: [id])
  supplierId               String
  sku                      String
  productName              String
  specification            String
  packageUnit              String
  quantity                 Int
  supplierCostSnapshot     Decimal @db.Decimal(14, 2)
  customerPriceSnapshot    Decimal @db.Decimal(14, 2)
  commissionRateSnapshot   Decimal @db.Decimal(7, 4)
  commissionAmountSnapshot Decimal @db.Decimal(14, 2)
  rebateRateSnapshot       Decimal @default(0) @db.Decimal(7, 4)
  rebateAmountSnapshot     Decimal @default(0) @db.Decimal(14, 2)
  lineTotal                Decimal @db.Decimal(14, 2)
  allocation               PurchaseAllocation?
  @@index([supplierId])
}
model PurchaseOrder {
  id          String @id @default(cuid())
  poNumber    String @unique
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  status      String @default("SUBMITTED")
  totalCost   Decimal @db.Decimal(14, 2)
  notes       String @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       PurchaseOrderItem[]
  @@index([supplierId, createdAt])
}
model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  variantId       String
  sku             String
  productName     String
  specification   String
  packageUnit     String
  quantity        Int
  supplierCost    Decimal @db.Decimal(14, 2)
  lineTotal       Decimal @db.Decimal(14, 2)
  allocations     PurchaseAllocation[]
  @@unique([purchaseOrderId, variantId])
}
model PurchaseAllocation {
  id                  String @id @default(cuid())
  purchaseOrderItemId  String
  purchaseOrderItem    PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  orderItemId         String @unique
  orderItem           OrderItem @relation(fields: [orderItemId], references: [id])
  quantity            Int
}
model Payment {
  id        String @id @default(cuid())
  orderId   String
  order     Order @relation(fields: [orderId], references: [id])
  amount    Decimal @db.Decimal(14, 2)
  method    String @default("BANK_TRANSFER")
  reference String @default("")
  notes     String @default("")
  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())
}
model Commission {
  id               String @id @default(cuid())
  supplierId       String
  supplier         Supplier @relation(fields: [supplierId], references: [id])
  orderId          String
  order            Order @relation(fields: [orderId], references: [id])
  customerId       String
  orderAmount      Decimal @db.Decimal(14, 2)
  commissionRate   Decimal @db.Decimal(7, 4)
  commissionAmount Decimal @db.Decimal(14, 2)
  rebateAmount     Decimal @default(0) @db.Decimal(14, 2)
  status           CommissionStatus @default(PENDING)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@unique([orderId, supplierId])
}
model Favorite {
  id         String @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  @@unique([customerId, variantId])
}
model Quotation {
  id            String @id @default(cuid())
  quoteNumber   String @unique
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  validUntil    DateTime
  paymentTerms  String
  deliveryTerms String @default("供應商直送；交貨日期另行確認")
  notes         String @default("")
  totalAmount   Decimal @db.Decimal(14, 2)
  createdAt     DateTime @default(now())
  items         Json
}
model AuditLog {
  id        String @id @default(cuid())
  userId    String?
  userName  String
  action    String
  entity    String
  entityId  String
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model PlatformSetting {
  id                       String @id @default("main")
  businessModel            String @default("COMMISSION")
  inventoryMode            String @default("DROP_SHIP")
  commissionRate           Decimal @default(0) @db.Decimal(7, 4)
  serviceFee               Decimal @default(0) @db.Decimal(14, 2)
  businessName             String @default("")
  taxId                    String @default("")
  customerServicePhone     String @default("")
  address                  String @default("")
  foodRegistrationNumber   String @default("")
  tradingEntity            String @default("")
  paymentMethods           String @default("")
  returnsPolicy            String @default("")
  privacyPolicy            String @default("")
  supplierDisclosure       String @default("")
  legalReviewConfirmed     Boolean @default(false)
  launchReady              Boolean @default(false)
  updatedAt                DateTime @updatedAt
}
model DailySequence {
  key   String @id
  value Int @default(0)
}
model NotificationOutbox {
  id        String @id @default(cuid())
  event     String
  entityId  String
  payload   Json
  channel   String @default("LINE_FUTURE")
  status    String @default("DISABLED")
  createdAt DateTime @default(now())
}
